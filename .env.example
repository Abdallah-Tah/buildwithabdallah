APP_NAME="Build With Abdallah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

ADMIN_NAME="Abdallah Mohamed"
ADMIN_EMAIL=admin@buildwithabdallah.com
ADMIN_PASSWORD=ChangeMe123!

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=buildwithabdallah
DB_USERNAME=buildwithabdallah
DB_PASSWORD=change-me

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Option A: Gmail SMTP (low volume / transactional) ---------------------
# Requires 2-Step Verification + a Google App Password
# (https://myaccount.google.com/apppasswords) used as MAIL_PASSWORD.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_ADDRESS="you@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Option B: Resend SMTP (recommended for newsletter broadcasts) ----------
# Create an account, verify buildwithabdallah.com (DNS SPF/DKIM), then use the
# API key as MAIL_PASSWORD. No package needed — just swap these four lines:
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=re_your_api_key
#   MAIL_FROM_ADDRESS="hello@buildwithabdallah.com"   # must be on the verified domain

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# LinkedIn OAuth — "Sign In with LinkedIn using OpenID Connect" product.
# Authorized redirect URL to register in the LinkedIn app:
#   https://buildwithabdallah.com/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Add w_member_social once the "Share on LinkedIn" product is enabled:
# LINKEDIN_SCOPES="openid profile email w_member_social"
# LINKEDIN_REDIRECT_URI=

# Facebook / Meta OAuth — "Facebook Login" product.
# Valid OAuth Redirect URI to register in the Meta app:
#   https://buildwithabdallah.com/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# FACEBOOK_SCOPES="public_profile,email"
# FACEBOOK_GRAPH_VERSION=v23.0
# FACEBOOK_REDIRECT_URI=
